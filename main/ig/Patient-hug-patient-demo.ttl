@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://example.org/ig/hug-training/Patient/hug-patient-demo> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "hug-patient-demo"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-patient" ;
       fhir:index 0 ;
       fhir:link <http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-patient>
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : Patient hug-patient-demo</b></p><a name=\"hug-patient-demo\"> </a><a name=\"hchug-patient-demo\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profil: <a href=\"http://fhir.ch/ig/ch-core/6.0.0/StructureDefinition-ch-core-patient.html\">CH Core Patient</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Alice Exemple  Female, Date de Naissance :1990-05-15</p><hr/></div><div xml:lang=\"en\" lang=\"en\"><hr/><p><b>English</b></p><hr/><p class=\"res-header-id\"><b>Generated Narrative: Patient hug-patient-demo</b></p><a name=\"en-hug-patient-demo\"> </a><a name=\"en-hchug-patient-demo\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"http://fhir.ch/ig/ch-core/6.0.0/StructureDefinition-ch-core-patient.html\">CH Core Patient</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Alice Exemple  Female, DoB: 1990-05-15</p><hr/></div></div>"
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Exemple" ] ;
     fhir:HumanName.given [
       fhir:value "Alice" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "female"] ;
  fhir:Patient.birthDate [ fhir:value "1990-05-15"^^xsd:date] .

# - ontology header ------------------------------------------------------------

<https://example.org/ig/hug-training/Patient/hug-patient-demo.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

